generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DispatchEventype {
  notification_send_alert @map("notification.send_alert")
  notification_send_sms   @map("notification.send_sms")
}

enum DispatchSeverity {
  medium
  high
  low
}

enum DispatchStatus {
  processing
  retry_send
  pending
  failed
  sent
}

enum DispatchOutboxEventype {
  notification_send_alert_result @map("notification.send_alert_result")
  notification_send_sms_result   @map("notification.send_sms_result")
}

enum DispatchOutboxStatus {
  pending
  queued
  failed
}

model NotificationDispatch {
  id                 String              @id @default(uuid())
  event_id           String              @unique
  job_id             String
  event_type         DispatchEventype
  user_id            String
  email_alert        String?
  phone              String?
  message            String
  severity           DispatchSeverity?
  status             DispatchStatus      @default(pending)
  attempts           Int                 @default(0)
  error_reason       String?
  processed_at       DateTime?
  created_at         DateTime            @default(now()) @db.Timestamptz()
  notificationOutbox NotificationOutbox?
}

model NotificationOutbox {
  id           String                 @id @default(uuid())
  dispatch_id  String                 @unique
  dispatch     NotificationDispatch   @relation(fields: [dispatch_id], references: [id])
  event_type   DispatchOutboxEventype
  payload      Json
  status       DispatchOutboxStatus   @default(pending)
  error_reason String?
  processed_at DateTime?
  created_at   DateTime               @default(now()) @db.Timestamptz()

  @@index([created_at])
  @@index([status])
}
